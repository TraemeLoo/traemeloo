# ================================
# TraemeLoo Backend - Environment Variables
# Copy this file to .env and fill in your values
# ================================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL via Supabase or your own Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/traemeloo?schema=public"

# JWT Secrets (generate strong random strings)
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this
JWT_REFRESH_EXPIRES_IN=30d

# Twilio (SMS/WhatsApp notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Google Maps API (for routing and geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# File uploads (Supabase Storage or AWS S3)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Payment Gateway (CardNet Dominican Republic)
CARDNET_MERCHANT_ID=your_cardnet_merchant_id
CARDNET_API_KEY=your_cardnet_api_key
CARDNET_API_URL=https://api.cardnet.com.do

# Platform Config
PLATFORM_COMMISSION_PERCENT=15
BASE_DELIVERY_FEE=80
DRIVER_PAY_PER_DELIVERY=120
FREE_DELIVERY_THRESHOLD=3000
CURRENCY=RD$

# CORS - Frontend URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
SELLER_URL=http://localhost:5175
